# 使用你指定的最新正统官方镜像
FROM ghcr.io/ucb-bar/chipyard:main

USER root
ENV IS_DOCKER=true

# 恢复默认的 Shell 行为，避免登录模式自动跳回家目录
SHELL ["/bin/bash", "-c"]

# 显式声明全局工作目录（如果镜像默认在 /chipyard，这里会强行锚定它）
WORKDIR /home/ubuntu/chipyard

# 第一步：动态寻找并锁定 chipyard 的真实绝对路径，就地跑 VLSI 初始化
RUN if [ -d "/chipyard" ]; then CP_PATH="/chipyard"; \
    elif [ -d "$HOME/chipyard" ]; then CP_PATH="$HOME/chipyard"; \
    elif [ -d "/root/chipyard" ]; then CP_PATH="/root/chipyard"; \
    else CP_PATH="/home/ubuntu/chipyard"; fi && \
    cd $CP_PATH && \
    # 强制在当前 bash 会话中拉起内嵌的 conda 环境 \
    source ./.conda-env/etc/profile.d/conda.sh && conda activate base && \
    # 执行初始化 \
    ./scripts/init-vlsi.sh asap7 openroad

# 第二步：再次精准切入 vlsi 目录修改配置文件并生成 buildfile
RUN if [ -d "/chipyard" ]; then CP_PATH="/chipyard"; \
    elif [ -d "$HOME/chipyard" ]; then CP_PATH="$HOME/chipyard"; \
    elif [ -d "/root/chipyard" ]; then CP_PATH="/root/chipyard"; \
    else CP_PATH="/home/ubuntu/chipyard"; fi && \
    cd $CP_PATH/vlsi && \
    # 修改示例配置文件中的硬编码路径 \
    sed -i "s|/path/to/asap7/|$PWD/asap7/|g" example-asap7.yml && \
    # 强制在当前 bash 会话中拉起内嵌的 conda 环境并加载 Hammer 路径 \
    source ../.conda-env/etc/profile.d/conda.sh && conda activate base && \
    export HAMMER_HOME=$PWD/hammer && \
    source $HAMMER_HOME/sourceme.sh && \
    # 重新构建 buildfile \
    make buildfile tutorial=asap7-openroad

# 默认启动进入 bash
CMD ["/bin/bash"]
