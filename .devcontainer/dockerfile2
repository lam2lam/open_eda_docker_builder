# 使用你指定的最新正统官方镜像
FROM ghcr.io/ucb-bar/chipyard:main

USER root
ENV IS_DOCKER=true

# 核心修复 1：显式告诉 Docker 每次运行 RUN 都去读取容器用户的 Conda 环境
SHELL ["/bin/bash", "-cl"]

# 核心修复 2：分步执行，不再使用复杂的单行 bash -c 包裹
# 第一步：初始化 VLSI 插件与 PDK
RUN ./scripts/init-vlsi.sh asap7 openroad

# 第二步：进入 vlsi 目录修改配置文件并生成 buildfile
RUN cd vlsi && \
    # 修改示例配置文件中的硬编码路径 \
    sed -i "s|/path/to/asap7/|$PWD/asap7/|g" example-asap7.yml && \
    \
    # 导出 Hammer 路径并加载 \
    export HAMMER_HOME=$PWD/hammer && \
    source \$HAMMER_HOME/sourceme.sh && \
    \
    # 重新构建 buildfile \
    make buildfile tutorial=asap7-openroad

# 默认启动进入 bash
CMD ["/bin/bash"]

